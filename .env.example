# Copy to ~/.config/upnext/.env (install -Dm600 .env.example ~/.config/upnext/.env).
# Debug builds also read ./.env from the folder they run in; installed ones don't.
# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Your 64-bit SteamID (17 digits). Optional: auto-detected from the local Steam client
# (loginusers.vdf) when unset. Otherwise see https://steamid.io
STEAM_ID=
# Optional overrides (defaults shown; `upnext doctor` prints every path in use)
# UPNEXT_DATA_DIR=~/.local/share/upnext   # the database (with the GOG and Epic sign-ins) and backups
# UPNEXT_DB=~/.local/share/upnext/upnext.db
# UPNEXT_CACHE_DIR=~/.cache/upnext        # the Claude CLI's working directory
# UPNEXT_STATIC_DIR=web/dist              # serve a UI from disk instead of the one in the binary
# UPNEXT_CLAUDE_BIN=claude                # found on PATH, else in ~/.local/bin
# UPNEXT_MODEL=sonnet          # model for picks (opus, sonnet, or a full id)
# UPNEXT_DIGEST_MODEL=sonnet   # model for review summaries and review tags
# UPNEXT_SAMPLED_MINUTES=120   # < this = "sampled", >= this = "played"
# UPNEXT_MAX_CANDIDATES=120    # cap on candidate lines sent to the LLM
# UPNEXT_PORT=8787
# UPNEXT_HEROIC_DIR=~/.config/heroic   # auto-detected (also the Flatpak path)
# UPNEXT_EPIC_MANIFESTS=C:\ProgramData\Epic\EpicGamesLauncher\Data\Manifests  # the Epic Games Launcher's installs; found on Windows
# UPNEXT_GALAXY_DB=/path/to/galaxy-2.0.db  # copy from a Windows machine running GOG Galaxy
# UPNEXT_GOG_TOKEN=~/.local/share/upnext/gog_token.json  # an older install's GOG sign-in, moved into the database when first read
# UPNEXT_LLM=claude-cli        # or api-key (Anthropic API, billed per token), or openai (local/compatible server)
# UPNEXT_OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama default; LM Studio http://localhost:1234/v1, vLLM http://host:8000/v1
# UPNEXT_OPENAI_MODEL=         # the server's model id, e.g. from GET {base}/models
# UPNEXT_OPENAI_API_KEY=       # only if the server requires one
# UPNEXT_OPENAI_DIGEST_MODEL=  # optional cheaper model on the same server for review summaries
# UPNEXT_DIGEST_LLM=same      # the AI for review summaries, second chances and hidden gems: same (as UPNEXT_LLM), or another backend with its own settings above
# RAWG_API_KEY=                # free per-user key (https://rawg.io/apidocs): tags/genres/ratings
# UPNEXT_LINUX=auto             # auto (on when running on Linux), on, or off: ProtonDB tiers in picks
# ANTHROPIC_API_KEY=           # for UPNEXT_LLM=api-key; can also be set on the Settings page
