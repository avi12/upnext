          "review_tag": "hook:slow"
        },
        {
          "code": "never",
          "label": "It never did",
          "line": "Never clicks for most players"
        }
      ]
    },
    {
      "name": "sessions",
      "question": "How long does a session need to be?",
      "required": false,
      "many": false,
      "choices": [
        {
          "code": "short",
          "label": "Under an hour is fine",
          "line": "Fine in sessions under an hour",
