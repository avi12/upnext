        },
        {
          "code": "playing",
          "label": "Still at it"
        },
        {
          "code": "shelved",
          "label": "Shelved, meaning to go back"
        },
        {
          "code": "stopped",
          "label": "Stopped, not going back"
        },
        {
          "code": "endless",
