          "label": "A journal, recap or clear objectives",
          "line": "Keeps you on track with a journal or recap",
          "helps": true
        },
        {
          "code": "hard_to_resume",
          "label": "Hard to resume: a week off and you're lost",
          "line": "Hard to pick back up after a break",
          "helps": false
        },
        {
          "code": "long_stretches",
