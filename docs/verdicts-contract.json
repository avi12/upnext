        {
          "code": "too_long",
          "label": "Too long",
          "aspects": [
            "length"
          ]
        },
        {
          "code": "pacing",
          "label": "The pacing dragged",
          "aspects": [
            "pacing"
          ]
        },
        {
          "code": "bugs",
          "label": "Bugs or performance",
          "aspects": [
            "bugs",
            "performance"
          ]
        },
        {
          "code": "too_hard",
          "label": "Too hard",
          "aspects": [
