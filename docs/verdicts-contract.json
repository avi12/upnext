  "limits": {
    "text_chars": 500,
    "stop_note_chars": 80,
    "factors": 3,
    "client_chars": 32,
    "show_at": 3,
    "percent_at": 5,
    "texts_per_game": 20
  },
  "text_checks": [
    {
      "code": "control",
      "why": "has invisible control characters",
      "pattern": "[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f-\\x9f\\u202a-\\u202e\\u2066-\\u206f\\ufff9-\\ufffb]",
      "flags": "i"
    },
    {
      "code": "wide",
      "why": "has full-width letters or digits",
      "pattern": "[\\uff0e-\\uff19\\uff20-\\uff3a\\uff41-\\uff5a]",
      "flags": "i"
    },
    {
      "code": "steam_profile",
      "why": "has a Steam profile or link",
      "pattern": "steamcommunity|s\\.team/|steam://",
      "flags": "i"
    },
    {
      "code": "email",
      "why": "has an email address",
      "pattern": "[a-z0-9._%+-]+@[a-z0-9-]+(\\.[a-z0-9-]+)*\\.[a-z]{2,}",
      "flags": "i"
    },
    {
      "code": "link",
      "why": "has a link or a web address",
      "pattern": "[a-z][a-z0-9+.-]*://|www\\.|[a-z0-9-]+\\.(com|net|org|io|gg|tv|me|co|ly|app|dev|xyz|info|ru|de|uk|fr|jp|cn|br|au|ca|eu|us|to|cc|link|site|online|club|live|store|shop|gl)([^a-z0-9]|$)",
      "flags": "i"
    },
    {
      "code": "handle",
      "why": "has an @handle",
      "pattern": "(^|[^a-z0-9_.@])@[a-z0-9_]{2,}",
      "flags": "i"
    },
    {
      "code": "long_number",
      "why": "has a long number, which could be a Steam ID",
      "pattern": "[0-9]{17}",
      "flags": "i"
    },
    {
      "code": "phone",
      "why": "has what looks like a phone number",
      "pattern": "\\+?\\(?[0-9]([ ().-]{0,2}[0-9]){8,}",
      "flags": "i"
    }
  ],
  "text_ignored": {
    "pattern": "[\\u00ad\\u034f\\u061c\\u180e\\u200b-\\u200f\\u2060-\\u2064\\ufeff]",
    "flags": "g"
  },
  "report_reasons": [
    {
      "code": "spam",
      "label": "Spam"
    },
    {
      "code": "personal",
      "label": "Personal information"
    },
    {
      "code": "abuse",
      "label": "Abuse or hate"
    },
    {
      "code": "off_topic",
      "label": "Not about this game"
    }
  ],
  "key_prefix": "upnext_v_"
}
