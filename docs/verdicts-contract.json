      ]
    },
    {
      "name": "stop_point",
      "question": "When is it fine to stop?",
      "required": false,
      "many": false,
      "choices": [
        {
          "code": "at_credits",
          "label": "After the main story; the rest is optional",
          "line": "Fine to stop after the credits"
