<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 (API 37): reaching the home network. Asked for only
         before an address typed or scanned that may be on it; computers
         found through the system's picker need none (LocalNetwork). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- The same app on a phone, a tablet and an Android TV. A TV has no
         touch screen and often no camera; the QR scanner's camera is
         optional already (zxing-android-embedded's manifest). -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.UpNext"
        tools:targetApi="37">

        <activity
            android:name=".ComputersActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AskActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The page keeps running through a turn of the screen or a pad
             plugged in, rather than reloading. -->
        <activity
            android:name=".WebActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The scanner turns with the phone, instead of its default of
             landscape only. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="android:screenOrientation" />
    </application>
</manifest>
