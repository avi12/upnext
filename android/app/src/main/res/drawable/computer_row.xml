<?xml version="1.0" encoding="utf-8"?>
<!-- A row in the list of computers: the surface colour, with a ring in the
     accent colour when a remote or a pad has it focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/upnext_surface" />
            <stroke android:width="2dp" android:color="@color/upnext_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#262A36" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/upnext_surface" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
